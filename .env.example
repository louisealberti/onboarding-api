DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSLMODE=disable
SERVER_PORT=8080

# Webhook (optional). Leave WEBHOOK_URL empty to disable status-change
# notifications entirely. WEBHOOK_SECRET, if set, signs each payload with
# HMAC-SHA256 in the X-Webhook-Signature header.
WEBHOOK_URL=
WEBHOOK_SECRET=