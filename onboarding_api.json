{
  "title": "Customer Onboarding API",
  "uid": "onboarding-api",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Request rate (req/s) by status",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (status) (rate(http_requests_total[1m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "p95 latency by route",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, path) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{path}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Customers created (total)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 8 },
      "targets": [{ "expr": "customers_created_total" }]
    },
    {
      "id": 4,
      "title": "Status transitions (rate, by destination)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 6, "y": 8 },
      "targets": [
        {
          "expr": "sum by (to) (rate(customer_status_transitions_total[5m]))",
          "legendFormat": "→ {{to}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Idempotent replays (rate)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 8 },
      "targets": [{ "expr": "rate(idempotent_replays_total[5m])" }]
    },
    {
      "id": 6,
      "title": "Webhook deliveries (rate, by outcome)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(webhook_deliveries_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "DB connection pool",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "db_connections_open", "legendFormat": "open" },
        { "expr": "db_connections_in_use", "legendFormat": "in use" },
        { "expr": "db_connections_idle", "legendFormat": "idle" }
      ]
    },
    {
      "id": 8,
      "title": "Goroutines",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [{ "expr": "go_goroutines" }]
    },
    {
      "id": 9,
      "title": "Process memory (resident)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [{ "expr": "process_resident_memory_bytes" }]
    }
  ]
}